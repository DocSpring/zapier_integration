# Zapier deploy key for `zapier-platform push` (CI/local). Get one by running
# `zapier-platform login`, which also writes it to ~/.zapierrc.
# NOT needed for `npm test` — the unit tests mock all HTTP with nock.
ZAPIER_DEPLOY_KEY=

# Optional: a real DocSpring API token for manual `zapier-platform invoke`
# against a live region. Never commit real values — keep them in .env (ignored).
# DOCSPRING_REGION=us
# DOCSPRING_TOKEN_ID=api_test_xxxxxxxxxxxxxxxxxxxx
# DOCSPRING_TOKEN_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
